#!/usr/bin/env node
/**
 * Stateless kicker for night-watch tasks: `advance [dir] [slug]` | `status [dir] [slug]`.
 * Meant for cron/launchd — no session, no daemon; each invocation takes the same
 * single-flight lock as `/watch advance`. advance sleeps a random 0..pollJitterMs
 * first so machines do not poll in lockstep.
 */

import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import { advanceTask, latestSlug, readConfig, statusText } from "../dist/driver.js";

const USAGE = "usage: night-watch advance [dir] [slug] | night-watch status [dir] [slug]  (dir defaults to cwd, slug to the latest task)";

function fail(msg) {
	process.stderr.write(`night-watch: ${msg}\n`);
	process.exit(1);
}

/** The shipped extension worker children `-e`: resolved from this bin's installed location. */
function extPath() {
	const p = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "src", "index.ts");
	if (!fs.existsSync(p)) fail(`extension not found next to the bin: ${p}`);
	return p;
}

const argv = process.argv.slice(2);
const cmd = argv[0];
if (cmd !== "advance" && cmd !== "status") fail(USAGE);
const dir = argv[1] ? path.resolve(argv[1]) : process.cwd();

try {
	if (cmd === "status") {
		const slug = argv[2] ?? latestSlug(dir);
		process.stdout.write(statusText(dir, slug) + "\n");
		process.exit(0);
	}
	// Jitter before claiming anything: schedules fire in lockstep across machines.
	const cfg = readConfig(dir);
	await new Promise((r) => setTimeout(r, Math.floor(Math.random() * cfg.pollJitterMs)));
	const slug = argv[2] ?? latestSlug(dir);
	process.stdout.write(advanceTask(dir, slug, extPath()).lines.join("\n") + "\n");
	process.exit(0);
} catch (err) {
	fail(err instanceof Error ? err.message : String(err));
}
