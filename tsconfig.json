{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023"],
		"types": ["node"],
		"forceConsistentCasingInFileNames": true,
		"target": "es2023",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
